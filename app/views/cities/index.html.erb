<div class="wall">
  <header class="header">
    <div>
      <h1>Temperature Compare</h1>
      <p>Fahrenheit up front, Celsius right under it, so you can say the same weather either way.</p>
    </div>

    <%= form_with url: cities_path, method: :post, class: "add" do |f| %>
      <%= f.text_field :city_name, placeholder: "Add a destination", required: true,
                       autocomplete: "off", "aria-label": "City name" %>
      <%= f.submit "Add" %>
    <% end %>
  </header>

  <% if @cities.any? %>
    <div class="strip">
      Destinations
      <span><%= @cities.size %> on the wall</span>
    </div>

    <div class="plaques">
      <% @cities.zip(@weather_data).each do |city_name, weather| %>
        <article class="plaque"
                 <% if weather %>style="--enamel-colour: var(--<%= enamel_for(weather[:temp_c]) %>)"<% end %>>
          <% if weather %>
            <p class="plaque__band"><%= weather[:condition] %></p>
            <h2 class="plaque__name"><%= weather[:city] %></h2>

            <p class="plaque__read">
              <span class="plaque__primary"><%= degrees(weather[:temp_f]) %><sup>°F</sup></span>
              <span class="plaque__secondary"><%= degrees(weather[:temp_c]) %>°C</span>
            </p>

            <div class="plaque__today">
              <div>
                <i>Low</i>
                <b><%= degrees(weather[:temp_min_f]) %>°F · <%= degrees(weather[:temp_min_c]) %>°C</b>
              </div>
              <div>
                <i>High</i>
                <b><%= degrees(weather[:temp_max_f]) %>°F · <%= degrees(weather[:temp_max_c]) %>°C</b>
              </div>
            </div>
          <% else %>
            <p class="plaque__band" style="--enamel-colour: #c9c2b2">No reading</p>
            <h2 class="plaque__name"><%= city_name %></h2>
            <p class="plaque__void">Nothing came back for this name. Check the spelling and add it again.</p>
          <% end %>

          <div class="plaque__pull">
            <%= button_to "Take down", remove_city_path(city_name: city_name), method: :delete,
                          form_class: "", "aria-label": "Take down #{city_name}" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="empty">
      <b>The wall is bare</b>
      Add a destination and it goes up as a plaque, painted by how warm it is right now.
    </p>
  <% end %>

  <section class="convert" data-controller="temperature-converter">
    <h2>Work it out yourself</h2>

    <div class="pair">
      <label for="fahrenheit-input">Fahrenheit</label>
      <input type="number" id="fahrenheit-input" placeholder="32"
             data-temperature-converter-target="fahrenheit"
             data-action="input->temperature-converter#convertFromFahrenheit">
    </div>

    <span class="to" aria-hidden="true">is</span>

    <div class="pair">
      <label for="celsius-input">Celsius</label>
      <input type="number" id="celsius-input" placeholder="0"
             data-temperature-converter-target="celsius"
             data-action="input->temperature-converter#convertFromCelsius">
    </div>
  </section>
</div>
